{
	"compileOnSave": true,
	"compilerOptions": {
		"baseUrl": ".",
		"importHelpers": true,
		"forceConsistentCasingInFileNames": true,
		"sourceMap": true,
		"noUnusedParameters": true,
		"noUnusedLocals": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "node",
		"target": "ES2022",
		"jsx": "react-jsx",
		"lib": [
			"DOM",
			"DOM.Iterable",
			"ES2022"
		],
		"types": [
			"chrome",
			"vite/client"
		],
		"allowSyntheticDefaultImports": true,
		"strict": true,
		"allowJs": true,
		"rootDir": "./src",
		"isolatedModules": true,
		"noEmit": true,
		"noFallthroughCasesInSwitch": true,
		"paths": {
			"~/*": [
				"./src/*"
			]
		}
	},
	"include": [
		"src/**/*"
	],
	"exclude": [
		"node_modules",
		".dccache",
	]
}
