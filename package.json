{
  "name": "cc-checker-chrome-extension",
  "version": "2.1.0",
  "description": "WCAG accessibility colour contrast checker chrome extension",
  "license": "MIT",
  "private": true,
  "type": "module",
  "author": {
    "name": "Alex Clapperton",
    "email": "hi@alexclapperton.co.uk",
    "url": "https://alexclapperton.co.uk"
  },
  "dependencies": {
    "chroma-js": "^3.2.0",
    "clsx": "^2.1.1",
    "copy-to-clipboard": "^3.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/chroma-js": "^3.1.2",
    "@types/chrome": "^0.2.9",
    "@types/node": "^26.5.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fflate": "^0.8.3",
    "globals": "^17.12.0",
    "postcss": "^8.5.28",
    "postcss-preset-env": "^11.5.2",
    "postcss-sort-media-queries": "^6.7.1",
    "prettier": "^3.9.6",
    "stylelint": "^17.15.0",
    "stylelint-use-logical": "^2.1.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2"
  },
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch",
    "package": "npm run build && node scripts/package.mjs",
    "lint": "npm run lint:ts && npm run lint:js && npm run lint:css && npm run format:check",
    "lint:ts": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "format": "prettier \"**/*.{js,mjs,ts,tsx,json,md,css,html,yml}\" --write",
    "format:check": "prettier \"**/*.{js,mjs,ts,tsx,json,md,css,html,yml}\" --check",
    "test": "npm run build && playwright test",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "browserslist": [
    "chrome >= 111"
  ]
}
